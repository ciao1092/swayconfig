#!/usr/bin/env bash
#
# sway-display-toggle.sh
# Detects available Sway outputs and toggles between display modes:
#   - mirroring (all enabled displays positioned at 0,0)
#   - extended (displays arranged side-by-side)
#   - only screen 1, 2, ..., N (only that display enabled)
#
# Usage:
#   ./sway-display-toggle.sh         # Cycle to next mode
#   ./sway-display-toggle.sh current # Show current mode
#   ./sway-display-toggle.sh list    # List available modes
#   ./sway-display-toggle.sh set <mode_name>  # Directly set a mode
#

set -euo pipefail

STATE_FILE="${XDG_RUNTIME_DIR:-/tmp}/sway-display-mode.state"

# Ensure jq and swaymsg are available
if ! command -v swaymsg >/dev/null 2>&1; then
    echo "Error: swaymsg not found. Ensure Sway is installed and running." >&2
    exit 1
fi

if ! command -v jq >/dev/null 2>&1; then
    echo "Error: jq is required but not installed." >&2
    exit 1
fi

# Fetch outputs from Sway JSON
# Filter out non-desktop devices (e.g. VR headsets) if non_desktop == true
OUTPUTS_JSON=$(swaymsg -t get_outputs -r 2>/dev/null || true)

if [ -z "$OUTPUTS_JSON" ] || [ "$OUTPUTS_JSON" = "null" ]; then
    echo "Error: Unable to get outputs from swaymsg." >&2
    exit 1
fi

# Read output names sorted deterministically
readarray -t OUTPUTS < <(echo "$OUTPUTS_JSON" | jq -r '.[] | select(.non_desktop | not) | .name' | sort)
NUM_OUTPUTS=${#OUTPUTS[@]}

if [ "$NUM_OUTPUTS" -eq 0 ]; then
    echo "Error: No displays detected." >&2
    exit 1
fi

# Notify user helper
notify() {
    local msg="$1"
    echo "$msg"
    if command -v notify-send >/dev/null 2>&1; then
        notify-send -t 2500 -a "Sway Display" "Display Mode" "$msg" 2>/dev/null || true
    fi
}

# Generate list of valid modes
# Modes: mirroring, extended, only 1, ..., only N
MODES=("mirroring" "extended")
for ((i=1; i<=NUM_OUTPUTS; i++)); do
    MODES+=("only screen $i")
done

# Apply mode function
apply_mode() {
    local target_mode="$1"
    local sway_cmds=()

    case "$target_mode" in
        mirroring)
            # Find a common resolution among active displays or enable all at pos 0 0
            # Set position 0 0 and enable for all outputs
            for out in "${OUTPUTS[@]}"; do
                sway_cmds+=("output \"$out\" enable pos 0 0")
            done
            ;;

        extended)
            # Position outputs side-by-side
            local current_x=0
            for out in "${OUTPUTS[@]}"; do
                # Get the width of the display from current mode or highest resolution mode
                local width
                width=$(echo "$OUTPUTS_JSON" | jq -r \
                    --arg name "$out" \
                    '.[] | select(.name == $name) | if .current_mode then .current_mode.width else (.modes // [{"width": 1920}])[0].width end')
                
                # Default fallback width if null or 0
                if [ -z "$width" ] || [ "$width" = "null" ] || [ "$width" -le 0 ]; then
                    width=1920
                fi

                # Scale adjustment: if scale is set and not 1, Sway positions use logical pixels
                local scale
                scale=$(echo "$OUTPUTS_JSON" | jq -r --arg name "$out" '.[] | select(.name == $name) | .scale // 1.0')
                if [ -n "$scale" ] && [ "$scale" != "null" ]; then
                    local logical_width
                    logical_width=$(python3 -c "import math; print(int(math.ceil($width / $scale)))" 2>/dev/null || echo "$width")
                    width="$logical_width"
                fi

                sway_cmds+=("output \"$out\" enable pos $current_x 0")
                current_x=$((current_x + width))
            done
            ;;

        only\ screen\ *)
            local screen_idx="${target_mode#only screen }"
            if ! [[ "$screen_idx" =~ ^[0-9]+$ ]] || [ "$screen_idx" -lt 1 ] || [ "$screen_idx" -gt "$NUM_OUTPUTS" ]; then
                echo "Error: Invalid screen index '$screen_idx'." >&2
                return 1
            fi

            local target_screen="${OUTPUTS[$((screen_idx - 1))]}"

            # Enable the target output at 0 0 first
            sway_cmds+=("output \"$target_screen\" enable pos 0 0")

            # Disable all other outputs
            for out in "${OUTPUTS[@]}"; do
                if [ "$out" != "$target_screen" ]; then
                    sway_cmds+=("output \"$out\" disable")
                fi
            done
            ;;

        *)
            echo "Error: Unknown display mode '$target_mode'." >&2
            return 1
            ;;
    esac

    # Execute batch swaymsg command
    local full_cmd
    full_cmd=$(IFS=';'; echo "${sway_cmds[*]}")
    swaymsg "$full_cmd" >/dev/null

    # Save state
    echo "$target_mode" > "$STATE_FILE"
    notify "Switched to: $target_mode"
}

# Determine current mode from state file or detection
get_current_mode() {
    if [ -f "$STATE_FILE" ]; then
        local saved_mode
        saved_mode=$(cat "$STATE_FILE" 2>/dev/null || true)
        for m in "${MODES[@]}"; do
            if [ "$m" = "$saved_mode" ]; then
                echo "$saved_mode"
                return 0
            fi
        done
    fi

    # Fallback: inspect actual Sway output states
    # Count active outputs
    local active_outputs
    readarray -t active_outputs < <(echo "$OUTPUTS_JSON" | jq -r '.[] | select(.active == true and (.non_desktop | not)) | .name')
    local num_active=${#active_outputs[@]}

    if [ "$num_active" -eq 1 ]; then
        for idx in "${!OUTPUTS[@]}"; do
            if [ "${OUTPUTS[$idx]}" = "${active_outputs[0]}" ]; then
                echo "only screen $((idx + 1))"
                return 0
            fi
        done
    fi

    # Check if multiple active and all at position 0,0 (mirroring)
    if [ "$num_active" -gt 1 ]; then
        local unique_positions
        unique_positions=$(echo "$OUTPUTS_JSON" | jq -r '[.[] | select(.active == true) | "\(.rect.x),\(.rect.y)"] | unique | length')
        if [ "$unique_positions" -eq 1 ]; then
            echo "mirroring"
            return 0
        fi
        echo "extended"
        return 0
    fi

    # Default fallback
    echo "${MODES[0]}"
}

# Command dispatch
ACTION="${1:-toggle}"

case "$ACTION" in
    list)
        echo "Detected outputs ($NUM_OUTPUTS): ${OUTPUTS[*]}"
        echo "Available modes:"
        for m in "${MODES[@]}"; do
            echo "  - $m"
        done
        ;;

    current)
        get_current_mode
        ;;

    set)
        if [ -z "${2:-}" ]; then
            echo "Usage: $0 set <mode>" >&2
            echo "Available modes: ${MODES[*]}" >&2
            exit 1
        fi
        apply_mode "$2"
        ;;

    toggle|next)
        CURRENT_MODE=$(get_current_mode)
        # Find index in MODES
        CURRENT_INDEX=-1
        for i in "${!MODES[@]}"; do
            if [ "${MODES[$i]}" = "$CURRENT_MODE" ]; then
                CURRENT_INDEX=$i
                break
            fi
        done

        # Next mode in loop
        NEXT_INDEX=$(( (CURRENT_INDEX + 1) % ${#MODES[@]} ))
        NEXT_MODE="${MODES[$NEXT_INDEX]}"
        apply_mode "$NEXT_MODE"
        ;;

    *)
        echo "Usage: $0 [toggle|current|list|set <mode>]" >&2
        exit 1
        ;;
esac
