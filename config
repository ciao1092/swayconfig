# Read `man 5 sway` for a complete reference.

exec lxpolkit
exec --no-startup-id ~/.config/sway/scripts/start_keyring.sh
exec blueman-applet
exec nm-applet

exec flatpak run io.github.martchus.syncthingtray --wait

exec wl-paste -t text --watch clipman store
bindsym Alt+V exec clipman pick -t rofi

exec bash -c "kwallet-query -r KeePassXC kdewallet | keepassxc --pw-stdin /home/carlo/passwords/Passwords.kdbx"

# KeePassXC
for_window [app_id="org.keepassxc.KeePassXC"] floating enable

### Variables
#
# Logo key. Use Mod1 for Alt.
set $mod Mod4

# Home row direction keys, like vim
set $left h
set $down j
set $up k
set $right l

# Your preferred terminal emulator
#set $term alacritty
set $term konsole --hide-menubar --hide-toolbars
#set $term gnome-terminal

# Your preferred application launcher
#set $menu wmenu-run
#set $menu "~/.config/rofi/launchers/type-1/launcher.sh"
set $menu "rofi -show drun -show-icons"

include ~/.config/sway/config.d/*.config
include /etc/sway/config.d/*
